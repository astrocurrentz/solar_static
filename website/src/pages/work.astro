---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { freewillCopy } from '../features/freewill/model';
import { freewillPath } from '../data/tool-routes';
import { getLocaleContent } from '../data/site';

const locale = 'en';
const content = getLocaleContent(locale);
---

<BaseLayout locale={locale} meta={content.work.meta} canonicalPath="/work/">
  <Header locale={locale} />
  <main class="page-shell">
    <h1 class="work-heading">{content.work.heading}</h1>
    <section class="work-tools" aria-labelledby="work-tools-heading">
      <h2 id="work-tools-heading">{content.work.toolsHeading}</h2>
      <a href={freewillPath}>{freewillCopy.title}</a>
      <p>{freewillCopy.listing}</p>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .work-heading {
    font-size: var(--type-heading);
  }

  .work-tools {
    display: grid;
    gap: var(--space-callout-gap);
    padding-block: var(--space-block);
    border-block: var(--border-thin) solid var(--color-rule);
  }

  .work-tools a {
    width: fit-content;
    font-weight: var(--font-weight-semibold);
  }
</style>
